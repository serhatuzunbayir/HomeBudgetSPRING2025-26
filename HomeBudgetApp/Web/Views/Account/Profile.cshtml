@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Profile</h1>
        <form asp-action="Profile" method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">New password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Leave unchanged to keep current password" />
            </div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>
</div>
