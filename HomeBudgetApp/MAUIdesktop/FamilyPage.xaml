<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MAUIdesktop"
             x:Class="MAUIdesktop.FamilyPage"
             x:DataType="local:FamilyViewModel"
             Title="Family">

    <Grid ColumnDefinitions="220,*">
        <Grid BackgroundColor="{StaticResource FinanceSidebar}"
              Padding="22"
              RowDefinitions="Auto,*,Auto">
            <VerticalStackLayout Spacing="8">
                <Label Text="Family Budget"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Text="Shared spending control"
                       FontSize="12"
                       TextColor="{StaticResource FinanceSidebarText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 Margin="0,34,0,0"
                                 Spacing="12">
                <Button Text="Personal page"
                        Clicked="OnPersonalClicked"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Text="Family"
                        Style="{StaticResource SuccessButtonStyle}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Column="1">
            <Grid Padding="28"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Family Management" Style="{StaticResource PageTitleStyle}" />
                        <Label x:Name="FamilyStatusLabel" Text="{Binding FamilyStatusText}" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Personal page"
                            Clicked="OnPersonalClicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalOptions="Center" />
                </Grid>

                <Border x:Name="NoFamilyPanel"
                        Grid.Row="1"
                        IsVisible="{Binding NoFamilyPanelVisible}"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="No family workspace is connected yet."
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Text="Create a household budget or accept a pending invitation to join shared expense tracking."
                                       Style="{StaticResource MutedLabelStyle}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Create family"
                                    Clicked="OnCreateFamilyClicked"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="10">
                            <Label Text="Pending Invitations" Style="{StaticResource SectionTitleStyle}" />
                            <Label x:Name="NoInvitationsLabel"
                                   Text="No pending invitations."
                                   IsVisible="{Binding NoInvitationsVisible}"
                                   Style="{StaticResource MutedLabelStyle}" />
                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding PendingInvitations}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:FamilyInvitationViewModel">
                                        <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding FamilyName}" FontSize="16" FontAttributes="Bold" />
                                                <Label Text="{Binding InvitedByDisplay}" Style="{StaticResource MutedLabelStyle}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="Accept"
                                                    Clicked="OnAcceptInvitationClicked"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SuccessButtonStyle}" />
                                            <Button Grid.Column="2"
                                                    Text="Decline"
                                                    Clicked="OnDeclineInvitationClicked"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid x:Name="FamilyWorkspace"
                      Grid.Row="1"
                      IsVisible="{Binding FamilyWorkspaceVisible}"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="18">
                    <Grid ColumnDefinitions="2*,*"
                          ColumnSpacing="18">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Spacing="6">
                                    <Label x:Name="FamilyNameLabel"
                                           Text="{Binding FamilyNameText}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                    <Label x:Name="FamilyRoleLabel"
                                           Text="{Binding FamilyRoleText}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                    <Label Text="Admins can invite registered users and remove members when needed."
                                           Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1"
                                                       Spacing="10"
                                                       VerticalOptions="Center">
                                    <Button x:Name="InviteButton"
                                            Text="Invite member"
                                            IsVisible="{Binding InviteButtonVisible}"
                                            Clicked="OnInviteMemberClicked" />
                                    <Button x:Name="DeleteFamilyButton"
                                            Text="Delete family"
                                            IsVisible="{Binding DeleteFamilyButtonVisible}"
                                            Clicked="OnDeleteFamilyClicked"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Access Status" Style="{StaticResource SectionTitleStyle}" />
                                <Label Text="Owner/Admin" Style="{StaticResource MutedLabelStyle}" />
                                <Label Text="Invite and remove members" FontSize="16" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Spacing="12">
                        <Label Text="Family Members" Style="{StaticResource SectionTitleStyle}" />
                        <Label x:Name="NoMembersLabel"
                               Text="No members yet."
                               IsVisible="{Binding NoMembersVisible}"
                               Style="{StaticResource MutedLabelStyle}" />
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding FamilyMembers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:FamilyMemberViewModel">
                                    <Border Margin="0,0,0,10"
                                            Style="{StaticResource CardBorderStyle}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" Style="{StaticResource MutedLabelStyle}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Role}"
                                                   TextColor="{StaticResource FinanceSuccess}"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Text="Remove"
                                                    IsVisible="{Binding CanRemove}"
                                                    Clicked="OnRemoveMemberClicked"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource DangerButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Family Expenses" Style="{StaticResource SectionTitleStyle}" />
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8">
                                <Picker x:Name="FamilyMemberFilterPicker"
                                        Title="Member"
                                        ItemsSource="{Binding FamilyMemberFilterOptions}"
                                        SelectedItem="{Binding SelectedMemberFilter}"
                                        ItemDisplayBinding="{Binding Label}" />
                                <Picker Grid.Column="1"
                                        x:Name="FamilyCategoryFilterPicker"
                                        Title="Category"
                                        ItemsSource="{Binding FamilyCategoryFilterOptions}"
                                        SelectedItem="{Binding SelectedCategoryFilter}"
                                        ItemDisplayBinding="{Binding Label}" />
                                <HorizontalStackLayout Grid.Row="1"
                                                       Spacing="4"
                                                       VerticalOptions="Center">
                                    <CheckBox x:Name="FamilyExpenseUseStartDateCheckBox"
                                              IsChecked="{Binding UseStartDate}"
                                              CheckedChanged="OnFamilyDateFilterChanged" />
                                    <Label Text="From" VerticalTextAlignment="Center" />
                                    <DatePicker x:Name="FamilyExpenseStartDatePicker"
                                                Date="{Binding StartDate}"
                                                IsEnabled="{Binding StartDateEnabled}"
                                                Format="MMM d, yyyy"
                                                DateSelected="OnFamilyDateSelected"
                                                VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="1"
                                                       Spacing="4"
                                                       VerticalOptions="Center">
                                    <CheckBox x:Name="FamilyExpenseUseEndDateCheckBox"
                                              IsChecked="{Binding UseEndDate}"
                                              CheckedChanged="OnFamilyDateFilterChanged" />
                                    <Label Text="To" VerticalTextAlignment="Center" />
                                    <DatePicker x:Name="FamilyExpenseEndDatePicker"
                                                Date="{Binding EndDate}"
                                                IsEnabled="{Binding EndDateEnabled}"
                                                Format="MMM d, yyyy"
                                                DateSelected="OnFamilyDateSelected"
                                                VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Apply"
                                        Clicked="OnApplyFamilyExpenseFiltersClicked"
                                        VerticalOptions="Center" />
                                <Button Text="Clear filters"
                                        Clicked="OnClearFamilyExpenseFiltersClicked"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </HorizontalStackLayout>
                            <Label x:Name="FamilyExpensesCaptionLabel"
                                   Text="{Binding FamilyExpensesCaption}"
                                   Style="{StaticResource MutedLabelStyle}" />
                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding FamilyExpenseRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:FamilyExpenseRowViewModel">
                                        <Grid Padding="0,9"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Description}" FontAttributes="Bold" />
                                                <Label Text="{Binding DetailDisplay}" Style="{StaticResource MutedLabelStyle}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountDisplay}"
                                                   TextColor="{StaticResource FinanceDanger}"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="FamilyBudgetOverviewPanel"
                            Grid.Row="3"
                            IsVisible="{Binding FamilyBudgetOverviewVisible}"
                            Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Family Budget Overview" Style="{StaticResource SectionTitleStyle}" />
                                    <Label x:Name="FamilyBudgetOverviewCaptionLabel"
                                           Text="{Binding FamilyBudgetOverviewCaption}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       x:Name="FamilyBudgetOverviewTotalLabel"
                                       Text="{Binding FamilyBudgetOverviewTotal}"
                                       Style="{StaticResource MetricValueStyle}"
                                       TextColor="{StaticResource FinanceDanger}"
                                       VerticalTextAlignment="Center" />
                            </Grid>

                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding FamilyBudgetSummaryRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:FamilyBudgetSummaryViewModel">
                                        <Grid Padding="0,9"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding CategoryName}" FontAttributes="Bold" />
                                                <Label Text="{Binding DetailDisplay}" Style="{StaticResource MutedLabelStyle}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding TotalSpentDisplay}"
                                                   TextColor="{StaticResource FinanceDanger}"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
